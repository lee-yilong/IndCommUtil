[submodule "third_party/wxWidgets"]
	path = third_party/wxWidgets
	url = https://github.com/wxWidgets/wxWidgets.git
	shallow = true
[submodule "third_party/spdlog"]
	path = third_party/spdlog
	url = https://github.com/gabime/spdlog.git
	shallow = true
[submodule "third_party/json"]
	path = third_party/json
	url = https://github.com/nlohmann/json.git
	shallow = true
[submodule "third_party/ModbusLib"]
	path = third_party/ModbusLib
	url = https://github.com/serhmarch/ModbusLib.git
	shallow = true
[submodule "third_party/sqlite"]
	path = third_party/sqlite
	url = https://github.com/algoritnl/sqlite-cmake.git
