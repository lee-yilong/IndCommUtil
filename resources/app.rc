// =========================================================================
// 应用资源文件
// =========================================================================
#define RT_MANIFEST 24

// 1. 应用程序图标
1 ICON "icons/app.ico"

    // 2. 引入你的 Manifest 文件（直接写文件名，因为资源编译器设置了 -I 路径）
    1 RT_MANIFEST "app.manifest"

    // #include \"wx/msw/wx.rc\"\n

    // 包含版本信息（虽然不是必需的，但这是标准做法）
    VS_VERSION_INFO VERSIONINFO FILEVERSION 0,
    1, 0, 0 PRODUCTVERSION 0, 1, 0,
    0 FILEFLAGSMASK 0x3fL FILEFLAGS 0x0L FILEOS 0x40004L FILETYPE 0x1L FILESUBTYPE 0x0L BEGIN BLOCK
    "StringFileInfo" BEGIN BLOCK "040904b0" BEGIN VALUE "CompanyName",
    "IndComm" VALUE "FileDescription", "Industrial Communication Utility" VALUE "FileVersion",
    "0.1.0.0" VALUE "InternalName", "IndComm" VALUE "LegalCopyright",
    "Copyright (C) 2026" VALUE "OriginalFilename", "IndComm.exe" VALUE "ProductName",
    "IndComm" VALUE "ProductVersion",
    "0.1.0.0" END END BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END END
