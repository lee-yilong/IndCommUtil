// 应用资源脚本
//
// 关键：定义 wxUSE_NO_MANIFEST=1，禁用 wxWidgets 内置的极简 manifest，
// 改用我们自己的 app.manifest（声明 requestedExecutionLevel="asInvoker"）。
// 缺少 requestedExecutionLevel 会让 Windows 启用 UAC 虚拟化，
// 导致 Shell 文件对话框拒绝保存、Shell_NotifyIcon 返回 0x05 等异常。

#define wxUSE_NO_MANIFEST 1

// 应用图标（同时用于 exe 图标、任务栏、托盘）
aaaa_app_icon ICON "icons/app.ico"

    // 自己的 manifest（RT_MANIFEST = 24）
    1 24 "app.manifest"

#include "wx/msw/wx.rc"
